# ==========================================================================
#  Unity .gitignore
#  Цель: клон репозитория должен открываться и работать без ручных действий.
# ==========================================================================

# --- Генерируемые Unity папки (пересоздаются автоматически) ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# --- Отчёты о падениях ---
sysinfo.txt
crashlytics-build.properties

# --- IDE и редакторы: всё это генерируется заново ---
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.opensdf
*.sdf
*.cache
*.ipch
*.tlog
*.lastbuildstate

# --- ОС ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Временные папки локальной сборки через dotnet ---
/.dotnet_home/
/.nuget_packages/

# ==========================================================================
#  .meta файлы Unity ОБЯЗАНЫ быть в репозитории: в них GUID'ы ассетов.
#  Без них Unity сгенерирует новые GUID'ы и все ссылки в сценах сломаются.
#  Ничего из Assets/**/*.meta игнорировать нельзя.
# ==========================================================================
!Assets/**/*.meta
!Assets/*.meta

# ==========================================================================
#  Данные карт.
#  В git лежит только PKmap — её использует сцена Assets/Scenes/Sandbox.unity.
#  garner2 (91 МБ) и 07xmas2 (82 МБ) остаются локально: для обычного git это
#  слишком много. Если понадобится их переносимость — переведём на git-lfs.
#  ВАЖНО: эти правила идут ПОСЛЕ строк с "!", иначе исключения не сработают.
# ==========================================================================
/Assets/Map/garner2/**/*.glb
/Assets/Map/garner2/**/*.glb.meta
/Assets/Map/07xmas2/**/*.glb
/Assets/Map/07xmas2/**/*.glb.meta

# ==========================================================================
#  Локальные бэкапы сцен: лежат вне Assets, поэтому Unity их не импортирует.
#  Удалить, когда лёгкая сцена окончательно приживётся.
# ==========================================================================
/_backup_scenes/
